{
  "name": "pixelfederation/event-store-symfony-bundle",
  "description": "Fork of prooph/event-store-symfony-bundle with Symfony 8 support",
  "license": "BSD-3-Clause",
  "replace": {
    "prooph/event-store-symfony-bundle": "^0.5"
  },
  "type": "symfony-bundle",
  "homepage": "https://github.com/pixelfederation/event-store-symfony-bundle",
  "authors": [
    {
      "name": "PixelFederation",
      "homepage": "https://github.com/pixelfederation",
      "role": "Maintainer"
    },
    {
      "name": "Alexander Miertsch",
      "email": "kontakt@codeliner.ws",
      "role": "Original author"
    },
    {
      "name": "Sascha-Oliver Prolic",
      "email": "saschaprolic@googlemail.com",
      "role": "Original author"
    },
    {
      "name": "Malte Blättermann",
      "email": "malte.blaettermann@googlemail.com",
      "role": "Original author"
    },
    {
      "name": "Ralf Junghanns",
      "email": "ralf.junghanns@gmail.com",
      "role": "Original author"
    },
    {
      "name": "Oskar Pfeifer-Bley",
      "email": "oskar@programming-php.net",
      "role": "Original author"
    }
  ],
  "keywords": [
    "prooph",
    "Symfony",
    "Bundle",
    "EventStore",
    "EventSourcing",
    "DDD",
    "PHP"
  ],
  "support": {
    "issues": "https://github.com/pixelfederation/event-store-symfony-bundle/issues",
    "source": "https://github.com/pixelfederation/event-store-symfony-bundle"
  },
  "autoload": {
    "psr-4": {
      "Prooph\\Bundle\\EventStore\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProophTest\\Bundle\\EventStore\\": "test"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-json": "*",
    "symfony/config": "^7.4 || ^8.1",
    "symfony/dependency-injection": "^7.4 || ^8.1",
    "symfony/http-kernel": "^7.4 || ^8.1",
    "symfony/framework-bundle": "^7.4 || ^8.1",
    "symfony/messenger": "^7.4 || ^8.1",
    "prooph/event-store": "^7.9.0"
  },
  "require-dev": {
    "prooph/pdo-event-store": "^1.12",
    "phpunit/phpunit": "^13.3",
    "symfony/yaml": "^7.4 || ^8.1",
    "friendsofphp/php-cs-fixer": "^3.95",
    "prooph/php-cs-fixer-config": "^0.5.0",
    "matthiasnoback/symfony-dependency-injection-test": "^6.3",
    "phpstan/phpstan": "^2.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "check": [
      "@cs",
      "@test"
    ],
    "cs": "php-cs-fixer fix -v --diff --dry-run",
    "cs-fix": "php-cs-fixer fix -v --diff",
    "test": "phpunit --no-coverage",
    "test-coverage": "phpunit",
    "phpstan": "phpstan analyse -c phpstan.neon -l 6 src"
  },
  "archive": {
    "exclude": [
      ".coveralls.yml",
      ".travis.yml",
      "benchmark",
      "build",
      "phpunit.xml*",
      "test"
    ]
  }
}
